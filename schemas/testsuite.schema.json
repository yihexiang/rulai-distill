{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rulai-skill.local/schemas/testsuite.schema.json",
  "title": "Trigger Pressure Test Suite",
  "type": "object",
  "required": ["schema", "package", "skills_in_scope", "cases"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "rulai-skill/testsuite/v1" },
    "package": { "type": "string" },
    "skills_in_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "expect", "difficulty", "prompt", "why"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]-[0-9]{2}$" },
          "expect": { "type": ["string", "null"] },
          "difficulty": { "enum": ["easy", "medium", "hard"] },
          "prompt": { "type": "string", "minLength": 4 },
          "why": { "type": "string", "minLength": 4 },
          "pairwise_with": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "allOf": [
    {
      "comment": "每个 suite 至少一条 cross-skill pairwise 用例，否则 qa 校验不通过",
      "anyOf": [
        { "properties": { "cases": { "contains": { "required": ["pairwise_with"] } } } }
      ]
    }
  ]
}
