{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rulai-distill.local/schemas/output-decision.schema.json",
  "title": "Output Decision（single / pack 形态决策）",
  "description": "td.py strategy 的可解释决策记录。policy=single-first-v1：默认保守。",
  "type": "object",
  "required": ["schema", "policy", "selected", "reasons", "counts"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "rulai-distill/output-decision@1" },
    "policy": { "const": "single-first-v1" },
    "generated_at": { "type": "string" },
    "requested": { "type": ["string", "null"], "enum": ["single", "pack", null] },
    "purpose": { "enum": ["learning", "reference", "workflow", "distribution", null] },
    "trigger_validation_ready": { "type": "boolean" },
    "promotion_budget": { "type": "integer", "minimum": 1 },
    "counts": {
      "type": "object",
      "required": ["total", "promoted", "router"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "promoted": { "type": "integer", "minimum": 0 },
        "router": { "type": "integer", "minimum": 0 }
      }
    },
    "selected": { "enum": ["single", "pack"] },
    "reasons": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "alternative": { "type": "string" },
    "over_budget": { "type": "boolean" }
  }
}
